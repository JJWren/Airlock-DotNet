<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>6f0d3b8e-3c4a-4f63-9a2e-1b7d5c9e2a41</UserSecretsId>
    <!-- As .NET 10's Blazor template sets it: NavigateTo during a static render ends the response instead of throwing. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The framework's scripts, blazor.web.js among them, come from a package that the SDK restores only once it sees a
         .razor file. The image restores before the components are copied (Build and Test), so Airlock asks for it. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Airlock.Application/Airlock.Application.csproj" />
    <ProjectReference Include="../Airlock.Domain/Airlock.Domain.csproj" />
    <ProjectReference Include="../Airlock.Infrastructure/Airlock.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Airlock.Web.Tests" />
  </ItemGroup>

</Project>
