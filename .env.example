# Copy this file to .env, next to docker-compose.yml. Git and Docker both ignore .env (DR-09).

# Required. The folder on this machine that Airlock may scan, as /uploads. It is mounted read-only.
SCAN_UPLOAD_PATH=

# Your NVD API key, from https://nvd.nist.gov/developers/request-an-api-key. Without one Airlock runs DEGRADED and
# refuses to start a scan.
NVD_API_KEY=

# The port Airlock answers on, on 127.0.0.1 only.
AIRLOCK_PORT=8080

# The console's level: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL or NONE. The Live Log is not affected.
LOG_LEVEL=Information

# The release that `docker compose up` runs: latest, or a version such as 2.0.0.
AIRLOCK_IMAGE_TAG=latest
